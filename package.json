{
  "name": "velox",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "VELOX cycling trainer — Vite + TypeScript build",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"vite\"",
    "dev:backend": "tsx ./server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e": "playwright test",
    "ci": "npm run type-check && npm run lint && npm test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.4",
    "zod": "^4.4.3",
    "express-rate-limit": "^6.10.0",
    "fit-file-parser": "^3.0.0",
    "leaflet": "^1.9.4",
    "localforage": "^1.10.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "8.57.1",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/simple-peer": "^9.11.8",
    "@types/web-bluetooth": "^0.0.21",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "globals": "17.6.0",
    "happy-dom": "^20.9.0",
    "mapillary-js": "^4.1.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.0",
    "vite": "^5.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7",
    "@playwright/test": "^1.47.0",
    "playwright": "^1.47.0",
    "@sentry/react": "^10.53.1"
  },
  "engines": {
    "node": ">=18"
  }
}
