# Vite exposes env vars prefixed with VITE_ to the client bundle.
# Copy this file to .env.local for local development.

# Optional: override the live-share signalling server URL in the browser.
# VITE_VELOX_SERVER=https://velox-u31w.onrender.com

# Optional: explicit backend URL used when the site is hosted on Pages or other static hosts.
# Example for Render: set this in your deployment environment (do NOT commit secrets into repo).
VITE_BACKEND_URL=https://your-render-app.onrender.com

# Strava OAuth client ID used to start the authorization flow.
# Defaults to 105048 when omitted.
# VITE_STRAVA_CLIENT_ID=105048

# Optional: redirect URI override for local dev.
# VITE_STRAVA_REDIRECT_URI=http://localhost:5173
# VITE_MAPILLARY_TOKEN=your_mapillary_access_token

# Backend server environment variables for server-side API proxying.
# Copy these into a separate .env file used by the backend server.
# STRAVA_CLIENT_ID=105048
# STRAVA_CLIENT_SECRET=your_client_secret
# MAPILLARY_TOKEN=your_mapillary_access_token
# TURN_URL=turn:your-turn-host:3478
# TURN_USERNAME=your_turn_username
# TURN_CREDENTIAL=your_turn_credential
